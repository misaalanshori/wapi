# ==============================================================================
# WAPI (WhatsApp Personal AI Assistant) - Ollama Deployment Configuration
# Example configuration for local / LAN Ollama instance (misapw-pc).
# Usage:
#   cp .env.ollama.example .env
# ==============================================================================

# Required: Passphrase used in WhatsApp to unlock/initialize a session (/init-session <secret>)
SECRET_WORD=change_me_to_a_secure_passphrase

# Required: Model Provider set to Ollama
PROVIDER=ollama

# Required: API Key (dummy string for local Ollama without auth)
PROVIDER_API_KEY=ollama

# Required: Model identifier hosted on Ollama
PROVIDER_MODEL_ID=lfm3-vl:2b-q8_0-128k

# Required: Host URL where Ollama is reachable from inside the container.
# Using OLLAMA_BASE_URL prevents host system environment (e.g. Windows OLLAMA_HOST=0.0.0.0) from overriding it.
OLLAMA_BASE_URL=http://misapw-pc:11434
OLLAMA_HOST=http://misapw-pc:11434

# Optional: Fallback Model (uncomment if you want a remote backup when misapw-pc is offline)
# FALLBACK_PROVIDER=opencode-go
# FALLBACK_MODEL_ID=deepseek-v4.1-flash
# FALLBACK_API_KEY=your_opencode_api_key

# Optional: Timezone for timestamps, scheduling, and agent time awareness (default: Asia/Jakarta)
TZ=Asia/Jakarta

# Optional: Directory path for persistent storage, SQLite DBs, and Baileys auth (default: /data)
DATA_DIR=/data

# Optional: Logging level: fatal, error, warn, info, debug, trace, silent (default: info)
LOG_LEVEL=info

# Optional: Thinking level for reasoning models (for 2B VL models, 'off' is recommended)
THINKING_LEVEL=off

# Optional: Additional system prompt / trust policies injected into the agent session
SYSTEM_PROMPT=

# Optional: Minimum interval for recurring cron schedules in seconds (default: 60)
MIN_SCHEDULE_INTERVAL_SECONDS=60

# Optional: Maximum active schedules per conversation session (default: 25)
MAX_SCHEDULES_PER_SESSION=25

# ==============================================================================
# Compaction Strategy (Scaled for 128k Context Window)
# Model lfm3-vl:2b-q8_0 has a 128k token context window.
# Thresholds are scaled proportionally to prevent context overflow:
# ==============================================================================

# Soft limit token count before the idle countdown begins (default: 50000 for 128k context)
# Below ~50k tokens, conversation remains 100% verbatim without compaction.
COMPACTION_SOFT_LIMIT_TOKENS=50000

# Idle silence window in minutes before background compaction executes (default: 15)
# Resets on every new message so active conversations are never interrupted.
COMPACTION_IDLE_MINUTES=15

# Target token count to compact down toward (default: 25000 for 128k context)
COMPACTION_TARGET_TOKENS=25000

# Head-to-Tail preservation ratio (1:3)
# Preserves initial goals/constraints (~6k tokens) and recent active context (~19k tokens)
COMPACTION_HEAD_RATIO=1
COMPACTION_TAIL_RATIO=3

# ==============================================================================
# Progress Streaming Thresholds
# ==============================================================================

# Minimum number of tool/thought steps before showing a live progress bubble (default: 3)
PROGRESS_MIN_STEPS=3

# Maximum seconds of tool execution before forcing progress bubble visibility (default: 90)
PROGRESS_MIN_SECONDS=90
