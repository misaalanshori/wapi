# ==============================================================================
# WAPI (WhatsApp Personal AI Assistant) - Configuration Template
# Copy this file to .env and customize for your deployment:
#   cp .env.example .env
# ==============================================================================

# Required: Passphrase used in WhatsApp to unlock/initialize a session (/init-session <secret>)
SECRET_WORD=change_me_to_a_secure_passphrase

# Required: LLM Model Provider (e.g. opencode-go, anthropic, openai, openrouter)
PROVIDER=opencode-go

# Required: API Key for the chosen provider
PROVIDER_API_KEY=your_provider_api_key_here

# Required: Model ID supported by the provider (e.g. mimo-v2.6-flash, deepseek-v4.1-flash)
PROVIDER_MODEL_ID=mimo-v2.6-flash

# Optional: Fallback Model System
# If the primary model fails or hits capacity, automatically falls back to this model.
# Re-attempts primary model only after the session has been idle for COMPACTION_IDLE_MINUTES.
FALLBACK_MODEL_ID=deepseek-v4.1-flash
# FALLBACK_PROVIDER=opencode-go
# FALLBACK_API_KEY=

# Optional: Timezone for timestamps, scheduling, and agent time awareness (default: Asia/Jakarta)
TZ=Asia/Jakarta

# Optional: Directory path for persistent storage, SQLite DBs, and Baileys auth (default: /data)
DATA_DIR=/data

# Optional: Logging level: fatal, error, warn, info, debug, trace, silent (default: info)
LOG_LEVEL=info

# Optional: Thinking level for reasoning models: off, low, medium, high (default: medium)
THINKING_LEVEL=medium

# Optional: Additional system prompt / trust policies injected into the agent session
# Example: Only truly trust +628123456789, ask before doing anything weird or token-heavy
SYSTEM_PROMPT=

# Optional: Minimum interval for recurring cron schedules in seconds (default: 60)
MIN_SCHEDULE_INTERVAL_SECONDS=60

# Optional: Maximum active schedules per conversation session (default: 25)
MAX_SCHEDULES_PER_SESSION=25

# Optional: If set, serves the pairing QR code as an HTML endpoint on this port (e.g. 8080)
# QR_HTTP_PORT=8080

# ==============================================================================
# Intelligent Compaction Strategy
# ==============================================================================

# Soft limit token count before the idle countdown begins (default: 150000)
# Below this limit, zero compaction ever happens.
COMPACTION_SOFT_LIMIT_TOKENS=150000

# Idle silence window in minutes before background compaction executes (default: 15)
# Resets on every new message so active conversations are never interrupted.
COMPACTION_IDLE_MINUTES=15

# Target token count to compact down toward (default: 80000)
COMPACTION_TARGET_TOKENS=80000

# Head-to-Tail preservation ratio (default: 1:3)
# Preserves initial goals/constraints (1 part) and recent active context (3 parts),
# compacting the intermediate chatter in the middle.
COMPACTION_HEAD_RATIO=1
COMPACTION_TAIL_RATIO=3

# ==============================================================================
# Progress Streaming Thresholds
# ==============================================================================

# Minimum number of tool/thought steps before showing a live progress bubble (default: 3)
# Set to 0 to disable debounce and show progress bubbles immediately on step 1.
PROGRESS_MIN_STEPS=3

# Maximum seconds of tool execution before forcing progress bubble visibility (default: 90)
# Set to 0 to show progress bubbles immediately.
PROGRESS_MIN_SECONDS=90
